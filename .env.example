# OceanScope environment variable names only.
# Copy to a local ignored .env file when implementation begins. Never commit real values.

# Application
OCEANSCOPE_ENVIRONMENT=
OCEANSCOPE_LOG_LEVEL=
OCEANSCOPE_PUBLIC_BASE_URL=
OCEANSCOPE_CORS_ORIGINS=
OCEANSCOPE_DATA_DIRECTORY=

# Database and cache
OCEANSCOPE_DATABASE_URL=
OCEANSCOPE_REDIS_URL=
OCEANSCOPE_POSTGRES_DB=
OCEANSCOPE_POSTGRES_USER=
OCEANSCOPE_POSTGRES_PASSWORD=

# Live AIS (server-side only; never expose through frontend build variables)
AISSTREAM_API_KEY=
AISSTREAM_BOUNDING_BOXES=
AISSTREAM_MESSAGE_TYPES=

# Marine forecast access. Leave the key unset for an eligible free non-commercial tier.
OPEN_METEO_API_BASE_URL=
OPEN_METEO_API_KEY=

# Optional object/artifact storage for verified source archives
OCEANSCOPE_OBJECT_STORE_ENDPOINT=
OCEANSCOPE_OBJECT_STORE_BUCKET=
OCEANSCOPE_OBJECT_STORE_ACCESS_KEY=
OCEANSCOPE_OBJECT_STORE_SECRET_KEY=

# Observability, if selected in a later phase
OCEANSCOPE_OTEL_EXPORTER_ENDPOINT=
OCEANSCOPE_ERROR_REPORTING_DSN=
